# Bind local by default. Do not expose externally without a reverse proxy and TLS.
UTAMO_HOST=127.0.0.1
UTAMO_PORT=5000
UTAMO_DEBUG=0
UTAMO_ALLOW_REMOTE=0
UTAMO_ENVIRONMENT=local

UTAMO_ADMIN_USERNAME=admin
# Set on first run or combine with UTAMO_RESET_ADMIN_PASSWORD=1 to rotate.
UTAMO_ADMIN_PASSWORD=
UTAMO_RESET_ADMIN_PASSWORD=0
UTAMO_SECRET_KEY=
UTAMO_SECURE_COOKIE=0
UTAMO_SESSION_HOURS=8
UTAMO_TRUSTED_HOSTS=
UTAMO_TRUSTED_PROXY_HOPS=0
UTAMO_LOGIN_MAX_FAILURES=5
UTAMO_LOGIN_WINDOW_SECONDS=900
UTAMO_LOGIN_MAX_CLIENTS=10000

UTAMO_PM3_MODE=ANALYSIS_ONLY
UTAMO_PM3_MAX_TIMEOUT=180
# Windows example: C:\ProxSpace\pm3
UTAMO_PM3_ALLOWED_ROOTS=
UTAMO_PM3_UPSTREAM_COMMIT=master

UTAMO_MAX_UPLOAD_BYTES=8388608
UTAMO_MAX_FORM_MEMORY_BYTES=2097152
UTAMO_EXPORT_FULL_KEYS=0
UTAMO_RUNTIME_DIR=runtime
UTAMO_RF_DATA_DIR=runtime/data

# Smart read-only acquisition
UTAMO_SMART_SCAN_DIR=runtime/smart_scans
UTAMO_SMART_SCAN_MAX_COMMANDS=12
UTAMO_SMART_SCAN_TOTAL_TIMEOUT=480
UTAMO_SMART_AUTO_DUMP=1
UTAMO_SMART_READ_NDEF=1
